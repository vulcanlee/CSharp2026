<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 這個套件會一併帶入 Microsoft.Agents.AI（AgentSkillsProvider 就在裡面）、Microsoft.Extensions.AI.OpenAI 與 OpenAI SDK -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.27.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- File 來源的技能包：把 skills 資料夾（SKILL.md 與範本檔）複製到輸出目錄，程式用 AppContext.BaseDirectory 找得到 -->
    <None Update="skills\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
